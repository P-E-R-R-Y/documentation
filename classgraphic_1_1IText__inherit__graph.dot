digraph "graphic::IText"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="graphic::IText",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Text interface."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="RayText",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classRayText.html",tooltip="Raylib Text class - references a RayFont, does not own it. Deleting the text never touches the font."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="SdlText",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classSdlText.html",tooltip="Une chaine rendue en texture, refaite quand elle change."];
  Node1 -> Node3 [id="edge3_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 -> Node4 [id="edge4_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="SfmlText",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classSfmlText.html",tooltip="Sfml Text class - references a SfmlFont, does not own it. Deleting the text never touches the font."];
}
