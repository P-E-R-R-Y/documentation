digraph "IGraphic2Module"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="IGraphic2Module",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="A vendor's 2D factory : window, input, loaded resources and the objects that reference them...."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="IModule",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classIModule.html",tooltip="Ce que tout module sait dire de lui-meme, et l'etat de sa dll."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="IGraphic3Module",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classIGraphic3Module.html",tooltip="A vendor's 3D factory. Extends IGraphic2Module : implementing it means implementing all of the 2D too..."];
  Node3 -> Node4 [id="edge3_Node000003_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="RayGraphicModule",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classRayGraphicModule.html",tooltip="Single concrete class implementing IGraphic3Module, which already IS-A IGraphic2Module via the interf..."];
  Node1 -> Node5 [id="edge4_Node000001_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="SdlGraphicModule",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classSdlGraphicModule.html",tooltip="SDL2 ne remplit que IGraphic2Module."];
  Node1 -> Node5 [id="edge5_Node000001_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 -> Node6 [id="edge6_Node000001_Node000006",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node6 [id="Node000006",label="SfmlGraphicModule",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classSfmlGraphicModule.html",tooltip="Sfml only implements IGraphic2Module - no IGraphic3Module, sfml has no native 3D. No fake IModel here..."];
}
